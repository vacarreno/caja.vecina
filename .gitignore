# =========================================
#  GITIGNORE - PROYECTO CAJA VECINA MUNICIPAL
#  Estructura: /client + /server
# =========================================

# -------- GLOBAL --------
.DS_Store
Thumbs.db
*.swp
*.tmp
*.temp

# -------- LOGS --------
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# -------- ENVIRONMENT FILES --------
.env
.env.*
!.env.example

# -------- ROOT CACHES --------
.cache/
tmp/
temp/

# =========================================
#              CLIENT (React/Vite)
# =========================================
client/node_modules/
client/dist/
client/.cache/
client/*.tsbuildinfo
client/.vite/
client/.eslintcache

# =========================================
#              SERVER (Node/Express)
# =========================================
server/node_modules/
server/dist/
server/uploads/
server/logs/
server/*.pid
server/*.db
server/*.sqlite

# -------- Generated directories --------
server/tmp/
server/cache/

# =========================================
#              EDITORES / IDE
# =========================================
.vscode/
.idea/
*.code-workspace

# =========================================
#              MISC
# =========================================
*.tgz
*.zip
*.rar
*.tar
*.gz
*.tgz
